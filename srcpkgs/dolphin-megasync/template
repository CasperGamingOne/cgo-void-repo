nostrip=yes
noshlibprovides=yes
noverifyrdeps=yes

do_install() {
	vmkdir usr/lib/qt6/plugins/kf6/kfileitemaction
	vmkdir usr/lib/qt6/plugins/kf6/overlayicon
	vmkdir usr/share/icons

	cp -a usr/lib/qt6/plugins/kf6/kfileitemaction/* ${DESTDIR}/usr/lib/qt6/plugins/kf6/kfileitemaction/
	cp -a usr/lib/qt6/plugins/kf6/overlayicon/* ${DESTDIR}/usr/lib/qt6/plugins/kf6/overlayicon/
	cp -a usr/share/icons/* ${DESTDIR}/usr/share/icons/

	vlicense ${FILESDIR}/LICENSE
}
