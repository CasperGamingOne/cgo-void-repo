# Template file for 'dolphin-megasync'
pkgname=dolphin-megasync
version=6.2.0
revision=1
archs="x86_64"
create_wrksrc=yes
depends="megasync>=5.3.0 dolphin"
short_desc="MEGA Desktop App plugin for Dolphin file manager"
maintainer="CasperGamingOne <caspergamingone@proton.me>"
license="custom:MEGA LIMITED CODE LICENCE"
homepage="https://mega.io/desktop"
distfiles="https://mega.nz/linux/repo/Arch_Extra/x86_64/dolphin-megasync-x86_64.pkg.tar.zst>dolphin-megasync-${version}_${revision}.tar.zst"
checksum=08e2f3b831dada0704b542f040bb02d2df945ac3a4918802a66375d9c7a4cb6c
