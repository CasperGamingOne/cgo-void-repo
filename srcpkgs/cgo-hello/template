# Template file for 'cgo-hello'
pkgname=cgo-hello
version=1.0.0
revision=1
short_desc="Demonstration package for cgo-void-repo"
maintainer="CasperGamingOne <caspergamingone@proton.me>"
license="MIT"
homepage="https://github.com/caspergamingone/cgo-void-repo"

do_install() {
	vmkdir usr/bin
	cat << 'EOF' > "${DESTDIR}/usr/bin/cgo-hello"
#!/bin/sh
echo "Hello from CasperGamingOne's Void Linux Repository!"
EOF
	chmod 755 "${DESTDIR}/usr/bin/cgo-hello"
	vlicense ${FILESDIR}/LICENSE
}
