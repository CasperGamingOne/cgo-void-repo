# Build directories and binary artifacts
binpkgs/
hostdir/
masterdir/
*.xbps
*.xbps.sig
*-repodata
*-repodata.sig

# Cryptographic private keys - NEVER COMMIT PRIVATE KEYS
*.rsa
*.priv
*.key
id_rsa*

# Whitelist public keys for repo-keys/ and docs/ (for website & GitHub Pages)
!repo-keys/*.pub
!repo-keys/*.pem
!repo-keys/*.plist
!docs/*.pem
!docs/*.pub
!docs/*.plist

# Void packages engine clone (lives side-by-side in ~/git/void-packages)
void-packages/

# Temporary and editor files
*.tmp
*.log
*.swp
*~
.DS_Store
